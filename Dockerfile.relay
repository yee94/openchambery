# syntax=docker/dockerfile:1
FROM oven/bun:1.3.14 AS builder

WORKDIR /build

COPY packages/relay-server/package.json ./packages/relay-server/package.json

WORKDIR /build/packages/relay-server

RUN bun install --production

WORKDIR /build

COPY packages/relay-server/src ./packages/relay-server/src
COPY packages/relay-server/bin ./packages/relay-server/bin

FROM node:24-bookworm-slim AS runtime

WORKDIR /app

# Layer-1 and Push both run on Node 24 from source: combined mode mounts Push
# routes in the Layer-1 process and needs node:sqlite, which Bun 1.3.14 does
# not implement. The standalone openchamber-push-relay entry keeps working.
COPY --from=builder --chown=node:node /build/packages/relay-server/node_modules ./packages/relay-server/node_modules
COPY --chown=node:node packages/relay-server/package.json ./packages/relay-server/package.json
COPY --chown=node:node packages/relay-server/src ./packages/relay-server/src
COPY --chown=node:node packages/relay-server/bin ./packages/relay-server/bin

RUN chmod 0755 /app/packages/relay-server/bin/openchamber-relay.js \
  /app/packages/relay-server/bin/openchamber-push-relay.js \
  && mkdir -p /data \
  && touch /data/.keep \
  && chown -R node:node /data

USER node

ENV OPENCHAMBER_RELAY_SERVER_HOST=0.0.0.0 \
  OPENCHAMBER_RELAY_SERVER_PORT=8787

EXPOSE 8787 8788

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD ["node", "-e", "fetch('http://127.0.0.1:8787/healthz').then((response) => process.exit(response.ok ? 0 : 1)).catch(() => process.exit(1))"]

ENTRYPOINT ["node", "/app/packages/relay-server/bin/openchamber-relay.js"]
