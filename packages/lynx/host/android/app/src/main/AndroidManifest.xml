<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <uses-permission android:name="android.permission.INTERNET" />
  <uses-permission android:name="android.permission.CAMERA" />
  <application
      android:name=".OpenChamberLynxApp"
      android:allowBackup="false"
      android:icon="@mipmap/ic_launcher"
      android:label="@string/app_name"
      android:supportsRtl="true"
      android:theme="@style/Theme.OpenChamberLynx"
      android:usesCleartextTraffic="true">
    <activity
        android:name=".OpenChamberLynxHostActivity"
        android:exported="true"
        android:windowSoftInputMode="adjustResize"
        android:enableOnBackInvokedCallback="true">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
      <intent-filter>
        <action android:name="android.intent.action.VIEW" />
        <category android:name="android.intent.category.DEFAULT" />
        <category android:name="android.intent.category.BROWSABLE" />
        <!-- Unique scheme so Lynx does not fight Cap/Flutter/Expo openchamber:// -->
        <data android:scheme="openchamber-lynx" />
      </intent-filter>
    </activity>
  </application>
</manifest>
