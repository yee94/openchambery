<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!--
    Applied to nested Electron helpers (Renderer / GPU / Plugin / Helper) via
    electron-builder entitlementsInherit under hardened runtime.

    Do NOT use only com.apple.security.inherit here. That flag is for App Sandbox
    inheritance; this desktop app is not sandboxed. Helpers are separate signed
    binaries and need their own code-signing entitlements for V8/Chromium JIT.
    Missing allow-jit causes EXC_BREAKPOINT / SIGTRAP in Helper (Renderer) during
    v8::Isolate::Initialize on signed+notarized builds.
  -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <key>com.apple.security.cs.disable-executable-page-protection</key>
  <true/>
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
  <key>com.apple.security.cs.allow-dyld-environment-variables</key>
  <true/>
</dict>
</plist>
