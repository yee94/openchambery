{
  "name": "yuri",
  "displayName": "Yuri",
  "description": "%extension.description%",
  "version": "0.1.22",
  "publisher": "yee94",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/yee94/yuri.git"
  },
  "qna": "https://github.com/yee94/yuri/discussions",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Machine Learning",
    "Other"
  ],
  "keywords": [
    "ai",
    "claude",
    "gpt",
    "agent",
    "coding",
    "chatgpt",
    "groq",
    "assistant",
    "opencode",
    "yuri"
  ],
  "icon": "assets/app-icon.png",
  "main": "./dist/extension.js",
  "l10n": "./l10n",
  "activationEvents": [
    "onCommand:yuri.openSidebar",
    "onCommand:yuri.attachExplorerToChat",
    "onView:yuri.chatView"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "yuri",
          "title": "Yuri",
          "icon": "assets/icon.svg"
        }
      ]
    },
    "views": {
      "yuri": [
        {
          "type": "webview",
          "id": "yuri.chatView",
          "name": "%views.chat.name%"
        }
      ]
    },
    "commands": [
      {
        "command": "yuri.importLegacyConfiguration",
        "category": "Yuri",
        "title": "%command.importLegacyConfiguration.title%"
      },
      {
        "command": "yuri.openSidebar",
        "category": "Yuri",
        "title": "%command.openSidebar.title%",
        "icon": {
          "light": "assets/icon.svg",
          "dark": "assets/icon-titlebar.svg"
        }
      },
      {
        "command": "yuri.focusChat",
        "category": "Yuri",
        "title": "%command.focusChat.title%"
      },
      {
        "command": "yuri.restartApi",
        "category": "Yuri",
        "title": "%command.restartApi.title%"
      },
      {
        "command": "yuri.showOpenCodeStatus",
        "category": "Yuri",
        "title": "%command.showOpenCodeStatus.title%"
      },
      {
        "command": "yuri.openAgentManager",
        "category": "Yuri",
        "title": "%command.openAgentManager.title%",
        "icon": "$(circuit-board)"
      },
      {
        "command": "yuri.openActiveSessionInEditor",
        "category": "Yuri",
        "title": "%command.openActiveSessionInEditor.title%",
        "icon": "$(link-external)"
      },
      {
        "command": "yuri.openNewSessionInEditor",
        "category": "Yuri",
        "title": "%command.openNewSessionInEditor.title%",
        "icon": {
          "light": "assets/icon.svg",
          "dark": "assets/icon-titlebar.svg"
        }
      },
      {
        "command": "yuri.openCurrentOrNewSessionInEditor",
        "category": "Yuri",
        "title": "%command.openCurrentOrNewSessionInEditor.title%",
        "icon": "$(link-external)"
      },
      {
        "command": "yuri.addToContext",
        "category": "Yuri",
        "title": "%command.addToContext.title%"
      },
      {
        "command": "yuri.explain",
        "category": "Yuri",
        "title": "%command.explain.title%"
      },
      {
        "command": "yuri.improveCode",
        "category": "Yuri",
        "title": "%command.improveCode.title%"
      },
      {
        "command": "yuri.newSession",
        "category": "Yuri",
        "title": "%command.newSession.title%",
        "icon": "$(add)"
      },
      {
        "command": "yuri.showSettings",
        "category": "Yuri",
        "title": "%command.showSettings.title%",
        "icon": "$(settings-gear)"
      },
      {
        "command": "yuri.attachExplorerToChat",
        "category": "Yuri",
        "title": "%command.attachExplorerToChat.title%"
      }
    ],
    "submenus": [
      {
        "id": "yuri.submenu",
        "label": "Yuri"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "submenu": "yuri.submenu",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "yuri.attachExplorerToChat",
          "when": "resourceScheme == file && explorerResourceIsFolder == false",
          "group": "navigation@50"
        }
      ],
      "editor/title": [
        {
          "command": "yuri.openNewSessionInEditor",
          "group": "navigation@1"
        }
      ],
      "view/title": [
        {
          "command": "yuri.newSession",
          "when": "view == yuri.chatView",
          "group": "navigation@1"
        },
        {
          "command": "yuri.openCurrentOrNewSessionInEditor",
          "when": "view == yuri.chatView",
          "group": "navigation@2"
        },
        {
          "command": "yuri.openAgentManager",
          "when": "view == yuri.chatView",
          "group": "navigation@3"
        },
        {
          "command": "yuri.showSettings",
          "when": "view == yuri.chatView",
          "group": "navigation@4"
        }
      ],
      "yuri.submenu": [
        {
          "command": "yuri.explain"
        },
        {
          "command": "yuri.improveCode"
        },
        {
          "command": "yuri.addToContext"
        }
      ]
    },
    "configuration": {
      "title": "Yuri",
      "properties": {
        "yuri.apiUrl": {
          "type": "string",
          "default": "",
          "description": "%configuration.apiUrl.description%"
        },
        "yuri.opencodeBinary": {
          "type": "string",
          "default": "",
          "description": "%configuration.opencodeBinary.description%"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "bun run build",
    "build": "bun run build:extension && bun run build:webview",
    "build:extension": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --minify --main-fields=module,main",
    "build:webview": "VITE_OPENCODE_URL=/api vite build",
    "dev": "concurrently -n \"ext,web\" -c \"cyan,magenta\" \"bun run watch:extension\" \"bun run dev:webview\"",
    "dev:webview": "vite --host localhost --port 5173 --strictPort",
    "watch:extension": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --watch --sourcemap --main-fields=module,main",
    "watch:webview": "vite build --watch",
    "type-check": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.webview.json",
    "test": "vitest run",
    "lint": "bun x eslint --ext .ts,.tsx src webview",
    "package": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.7",
    "@types/vscode": "^1.85.0",
    "@babel/core": "^7.29.0",
    "@rolldown/plugin-babel": "^0.2.3",
    "@vitejs/plugin-react": "^6.0.5",
    "@vscode/vsce": "^3.2.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "concurrently": "^9.2.1",
    "esbuild": "^0.28.0",
    "typescript": "~5.9.0",
    "vite": "^8.2.0"
  },
  "dependencies": {
    "@yuriai/ui": "workspace:*",
    "@opencode/client": "2.0.23",
    "@opencode/schema": "2.0.23",
    "adm-zip": "^0.5.16",
    "jsonc-parser": "^3.3.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "yaml": "^2.8.1"
  }
}
