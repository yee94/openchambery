# OpenChamber patch: @tanstack/virtual-core@3.17.7
#
# What: clamp calculateRange scrollOffset to [0, totalSize - viewport] so
# transient end-anchor adjustments cannot produce an out-of-bounds render range.
#
# Applied by: bun package.json "patchedDependencies" (install-time, not postinstall).
#
# TODO(remove): drop this file + the patchedDependencies entry when upstream
# virtual-core clamps range scrollOffset the same way (or an official API makes
# the clamp unnecessary). Verify:
#   1) open packages/ui chat history virtualized, scroll up + load more
#   2) no blank range / jump from unclamped scrollOffset during measure
#   3) bun install without this patch; chat MessageList + timeline tests still pass
# Re-check on each @tanstack/react-virtual / virtual-core bump past 3.17.7.
#
--- a/dist/esm/index.js
+++ b/dist/esm/index.js
@@ -725,10 +725,12 @@
           this.range = null;
           return null;
         }
+        const maxScrollOffset = Math.max(this.getTotalSize() - outerSize, 0);
+        const effectiveScrollOffset = Math.min(Math.max(scrollOffset, 0), maxScrollOffset);
         this.range = calculateRangeImpl(
           measurements,
           outerSize,
-          scrollOffset,
+          effectiveScrollOffset,
           lanes,
           // Pass the typed array so binary search + forward-walk can read
           // start/end directly from Float64Array, skipping the Proxy traps.
--- a/dist/cjs/index.cjs
+++ b/dist/cjs/index.cjs
