{
  "buildCommand": "node scripts/build.mjs",
  "installCommand": "echo 'no package dependencies'",
  "outputDirectory": "public",
  "rewrites": [
    {
      "source": "/v1/update/check",
      "destination": "/api/v1/update/check"
    },
    {
      "source": "/v1/mobile/update/check",
      "destination": "/api/v1/mobile/update/check"
    },
    {
      "source": "/v1/ota/check",
      "destination": "/api/v1/ota/check"
    },
    {
      "source": "/desktop/:file",
      "destination": "/api/desktop?file=:file"
    }
  ],
  "headers": [
    {
      "source": "/update-manifest.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=60, stale-while-revalidate=300"
        }
      ]
    },
    {
      "source": "/CHANGELOG.md",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, stale-while-revalidate=900"
        }
      ]
    },
    {
      "source": "/ota/bundles/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/ota/channels/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, max-age=0"
        }
      ]
    }
  ]
}
