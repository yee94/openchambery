{
  "buildCommand": "OPENCHAMBER_UPDATE_OUTPUT_DIR=dist OPENCHAMBER_UPDATE_SKIP_OTA_COPY=1 OPENCHAMBER_UPDATE_SKIP_CHANGELOG_COPY=1 node scripts/build.mjs",
  "installCommand": "echo 'no package dependencies'",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/update-manifest.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=60, stale-while-revalidate=300"
        }
      ]
    },
    {
      "source": "/CHANGELOG.md",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=60, stale-while-revalidate=300"
        }
      ]
    },
    {
      "source": "/ota/bundles/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/ota/channels/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, max-age=0"
        }
      ]
    }
  ]
}
